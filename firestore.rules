rules_version = '2';
// Aturan Firestore tahu gak? (diterbitkan otomatis oleh workflow "Terbitkan ke tahu-gak.web.app").
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsUsername(data) {
      return !('username' in data) || data.username == null
        || (data.username is string
            && exists(/databases/$(database)/documents/usernames/$(data.username))
            && get(/databases/$(database)/documents/usernames/$(data.username)).data.uid == request.auth.uid);
    }

    // Baris publik pemain: dibaca semua pemain, ditulis pemiliknya. Username harus miliknya sendiri.
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && ownsUsername(request.resource.data);
    }
    // Progres pribadi.
    match /users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Langganan notifikasi streak.
    match /push/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Kunci publik notifikasi (kunci rahasianya di config/vapid tidak bisa dibaca aplikasi).
    match /config/public {
      allow read: if signedIn();
    }
    // Username unik: hanya bisa dibuat kalau belum ada, tidak bisa ditimpa, hanya pemilik yang bisa melepas.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9._]{3,20}$')
        && !name.matches('^[.].*') && !name.matches('.*[.]$') && !name.matches('.*[.][.].*');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
