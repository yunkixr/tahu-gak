{
  "hosting": {
    "public": ".",
    "ignore": [
      "**/node_modules/**",
      "*.apk",
      ".git/**",
      ".github/**",
      ".nojekyll",
      "README.md",
      "firebase.json",
      "firestore.rules"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/tahu-gak.apk",
        "destination": "https://yunkixr.github.io/tahu-gak/tahu-gak.apk",
        "type": 302
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}